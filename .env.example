# Core app
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=32

# Cookies
# Set to true after HTTPS is enabled.
SESSION_COOKIE_SECURE=false

# External APIs
DEEPSEEK_API_KEY=
HUOBAN_API_HOST=api.huoban.com
HUOBAN_TABLE_ID=
HUOBAN_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info
